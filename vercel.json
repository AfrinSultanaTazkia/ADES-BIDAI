{
  "version": 2,
  "name": "ades-bidai",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ades-bidai.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "outputDirectory": "frontend/dist",
  "buildCommand": "echo 'Using pre-built frontend'"
}
