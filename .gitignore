# ==============================================================================
# ADES BIDAI - .gitignore
# ==============================================================================

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution & Build
build/
dist/
!frontend/dist/
!frontend/dist/**
node_modules/
frontend/node_modules/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
!frontend/dist/
!frontend/dist/**
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDEs & Editor Configuration
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Model Artifacts (ignoring binary/checkpoint files, keeping models/ directory intact)
*.pkl
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.bin
*.model
*.pb

# Temporary & Cache Files (keeping data/ directory intact)
_pages_backup/
*.log
*.tmp
*.temp
data/temp/
data/cache/

# SQLite databases
*.db
data/ades_bidai_allocations.db
